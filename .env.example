# Copy to .env for local development. In production these are set in
# Railway → service → Variables, never committed.
#
# Required to boot:  MONGODB_URI, JWT_SECRET
# Required to grade: CLAUDE_API_KEY
# The server prints a warning at startup for anything missing or placeholder-looking.

# ===========================
# SERVER
# ===========================
NODE_ENV=development
PORT=5000
# Railway routes your public domain to a specific target port. If the site
# returns 502 while the container is healthy, that target port does not match
# PORT: Settings → Networking → domain → Target port.

# ===========================
# DATABASE
# ===========================
# Also stores exam audio, via GridFS. Railway's filesystem is ephemeral, so
# recordings cannot live on disk.
MONGODB_URI=mongodb://localhost:27017/cefr-exam

# ===========================
# AUTH
# ===========================
# Use a long random value, NOT a memorable phrase — anyone who guesses it can
# forge a login for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Optional but recommended. If unset, refresh tokens are signed with a value
# derived from JWT_SECRET and the server warns at startup.
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=30d

# ===========================
# AI EVALUATION (required for grading)
# ===========================
# From https://console.anthropic.com — a placeholder value makes every
# evaluation fail at submission time.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-20250805
CLAUDE_MAX_TOKENS=2000

# Score at or above which an attempt counts as passed.
# Lowest mark that counts as a pass, on the 75-point Multilevel scale (31 = B1).
PASS_SCORE=31

# ===========================
# TRANSCRIPTION (optional)
# ===========================
# Claude's API cannot accept audio, so speech-to-text happens separately.
# With a key set, recordings are transcribed server-side with Whisper — accurate
# and browser-independent. Without one, the app falls back to the browser's own
# speech recognition, which only Chrome and Edge support well.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
EXAM_LANGUAGE=en

# ===========================
# PAYMENTS (optional)
# ===========================
# Real Stripe secret keys are ~107 characters. A short value means the key is
# truncated and every payment call will fail.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================
# EMAIL (optional — verification and password reset)
# ===========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# ===========================
# SEEDING
# ===========================
# Account recorded as the author of seeded exams. Created if absent.
SEED_ADMIN_EMAIL=system@cefr-exam.com

# --- Capacity (safe defaults; raise only if you know why) ---
# Requests per signed-in student per 15 minutes. One full mock costs ~30.
RATE_LIMIT_MAX=600
# Sign-in attempts per address per 15 minutes — deliberately strict.
AUTH_RATE_LIMIT_MAX=30
# How many AI calls may be in flight at once, server-wide. The answers within
# one attempt are marked in parallel, so a full 8-answer mock fits in a single
# wave at 12. Raise it if a whole class queues; lower it if the logs show
# repeated 429 retries (past your account's rate limit it buys nothing).
AI_CONCURRENCY=12
# Retries for a rate-limited or failing AI call before an answer is given up on.
CLAUDE_MAX_RETRIES=4

# Language the AI writes its feedback in: uz (Uzbek Latin, default),
# uz-cyrl (Uzbek Cyrillic), ru (Russian), or en (English).
# Words quoted from the student's answer always stay in English.
FEEDBACK_LANGUAGE=uz

# --- Pronunciation assessment (Azure AI Speech) ---
# Leave these unset and pronunciation is reported as "not assessed". That is the
# honest state: the marking model reads a transcript and cannot hear the student,
# so without a speech assessor there is no pronunciation evidence to report.
#
# Create a Speech resource at portal.azure.com, then Keys and Endpoint.
# The free tier (F0) allows only ONE recording at a time and cannot be raised,
# so it suits trying this out, not a class. Standard (S0) allows 100.
AZURE_SPEECH_KEY=
# The resource's Location, lowercase, no spaces — e.g. westeurope
AZURE_SPEECH_REGION=
# Locale the students are assessed against.
AZURE_SPEECH_LOCALE=en-US
# Stress and intonation scoring. Billed on top of the base rate, and Azure
# supports it for en-US only — so it is off unless asked for.
AZURE_SPEECH_PROSODY=false
# How many seconds of each attempt to assess. Pronunciation is a stable trait
# within one sitting, so a sample of the student's longest answers measures it
# as well as the whole mock would, at a fraction of the cost. Azure refuses
# clips over 30s, so this is spent in ~28-second pieces.
PRONUNCIATION_BUDGET_SECONDS=60
