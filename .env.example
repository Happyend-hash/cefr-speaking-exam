# ===========================
# SERVER CONFIGURATION
# ===========================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ===========================
# DATABASE
# ===========================
MONGODB_URI=mongodb://localhost:27017/cefr-exam
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/cefr-exam

# ===========================
# JWT & SECURITY
# ===========================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRE=30d

# ===========================
# CLAUDE API (AI EVALUATION)
# ===========================
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-5-20250805
CLAUDE_MAX_TOKENS=2000

# ===========================
# STRIPE PAYMENT PROCESSING
# ===========================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ===========================
# EMAIL CONFIGURATION
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@cefrexam.com

# ===========================
# AWS S3 (FOR AUDIO STORAGE)
# ===========================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=cefr-exam-audio

# ===========================
# SPEECH-TO-TEXT SERVICE
# ===========================
# Options: google, aws, azure
SPEECH_TO_TEXT_PROVIDER=google
GOOGLE_SPEECH_API_KEY=your_google_api_key

# ===========================
# ADMIN CREDENTIALS
# ===========================
ADMIN_EMAIL=admin@cefrexam.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ===========================
# PRICING CONFIGURATION
# ===========================
PRICE_PER_EXAM_USD=15
PRICE_PER_EXAM_DISCOUNTED_USD=12
BULK_EXAM_DISCOUNT_THRESHOLD=10

# ===========================
# LOGGING
# ===========================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ===========================
# FEATURES
# ===========================
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_DEMO_MODE=true
